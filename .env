OPENAI_API_KEY = ""
OPENAI_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
MODEL_NAME = "qwen3.5-plus-2026-02-15"

# ===== 用户数据目录（仅开发环境生效）=====
# PersonalData 根目录路径；留空则使用 项目根/PersonalData/
# 打包环境固定使用 exe所在目录/PersonalData/，不读取此项
PERSONAL_DATA_DIR='D:\PersonalWindowGLM\PersonalData'

SKILL_AGENT_UI_SHOW_TOOL_CALLS= 1
DEFAULT_SKILL_AGENT_USER="kimido"

# ===== 重复工具调用检测配置 =====
# 是否启用工具调用去重检测（true/false）
TOOL_CALL_DEDUPLICATION_ENABLED=true

# 连续多少次重复调用后自动终止（默认: 3）
MAX_CONSECUTIVE_REPEATS=3

# 重复检测的历史记录窗口大小（默认: 10）
REPEAT_DETECTION_WINDOW_SIZE=10

# ===== 窗口尺寸配置 =====
# 窗口宽度（默认: 1200，最小: 400）
WINDOW_WIDTH=1500

# 窗口高度（默认: 800，最小: 300）
WINDOW_HEIGHT=930

# 窗口最小宽度（Tauri 前端生效，默认: 800）
WINDOW_MIN_WIDTH=800

# 窗口最小高度（Tauri 前端生效，默认: 600）
WINDOW_MIN_HEIGHT=600

# ===== 定时任务配置 =====
# 定时任务触发智能体会话时，是否自动弹出主窗口并打开会话
# 默认: false (后台执行，不弹出窗口)
SCHEDULED_TASK_SHOW_WINDOW=false

# ===== 危险命令检测配置 =====
# 是否启用危险命令检测（true/false）
DANGEROUS_COMMAND_CHECK_ENABLED=true

# 危险命令前缀列表（匹配命令开头），每行一个，留空使用默认值
# DANGEROUS_COMMAND_PREFIXES=del \nerase \nrmdir \nrd \ncopy \nmove \nren \nrename \nmkdir \nmd

# 危险命令包含模式列表（匹配命令任意位置），每行一个，留空使用默认值
# DANGEROUS_COMMAND_CONTAINS= > \n >> \n set-content \n add-content \n out-file \n new-item \n remove-item \n rm

# ===== ASR ONNX 模型配置 =====
# ONNX 模型目录路径（留空则使用自动下载的模型）
ASR_ONNX_MODEL_PATH=''

# 模型不存在时是否自动下载（true/false，默认 true）
ASR_AUTO_DOWNLOAD=true

# ===== TTS 模型配置 =====
# TTS 模型类型（zh=中文，zh_en=中英文）
TTS_MODEL_TYPE='zh_en'

# TTS 模型目录路径（留空则使用自动下载的模型）
TTS_MODEL_PATH=''

# TTS 说话人 ID（默认 0）
TTS_SPEAKER_ID='0'

# TTS 语速（默认 1.0，范围 0.5-2.0）
TTS_SPEED='1.5'

# 程序启动时自动加载 TTS 模型（true/false）
TTS_AUTO_LOAD='false'

# 模型不存在时是否自动下载（true/false，默认 true）
TTS_AUTO_DOWNLOAD=true

# ===== UI Automation 配置 =====
# 是否启用 UI Automation 功能（true/false）
UIA_ENABLED=true

# UI Automation 操作超时时间（毫秒，默认 5000）
UIA_TIMEOUT_MS=5000

# 是否启用 OmniParser V2 视觉 fallback（true/false，默认 false）
OMNIPARSER_ENABLED=false

# OmniParser 模型路径（留空则使用自动下载的模型）
OMNIPARSER_MODEL_PATH=''
LIVE2D_MODEL_NAME='dafeng2'
LIVE2D_ENABLED='true'
ASR_REALTIME_AUTO_LOAD='false'
AUDIO_INPUT_DEVICE='1'
UI_THEME_MODE='system'
HOTKEY_SEND_MESSAGE='enter'
HOTKEY_NEWLINE='ctrl+enter'
# 留空则自动使用 %APPDATA%/OpenPersonalAgent/PersonalData/model/asr 下的默认模型
ASR_REALTIME_MODEL_PATH=''

TOOL_OUTPUT_MAX_LENGTH=999999
TOOL_TRUNCATE_SHOW_DETAILS=true
LIVE2D_BALL_WIDTH='200'
LIVE2D_BALL_HEIGHT='400'
LIVE2D_AUTO_LOAD='false'
