# ===== 重复工具调用检测配置 =====
# 是否启用工具调用去重检测（true/false）
TOOL_CALL_DEDUPLICATION_ENABLED=true

# 连续多少次重复调用后自动终止（默认: 3）
MAX_CONSECUTIVE_REPEATS=3

# 重复检测的历史记录窗口大小（默认: 10）
REPEAT_DETECTION_WINDOW_SIZE=10

# ===== Skill 执行自动总结配置 =====
# 是否启用 Skill 执行自动总结（true/false，默认 false）
SKILL_SUMMARY_ENABLED=true

# ===== 窗口尺寸配置 =====
# 窗口宽度（默认: 780，最小: 400）
WINDOW_WIDTH=1280

# 窗口高度（默认: 620，最小: 300）
WINDOW_HEIGHT=800

# ===== 定时任务配置 =====
# 定时任务触发智能体会话时，是否自动弹出主窗口并打开会话
# 默认: false (后台执行，不弹出窗口)
SCHEDULED_TASK_SHOW_WINDOW=false

# ===== 危险命令检测配置 =====
# 是否启用危险命令检测（true/false）
DANGEROUS_COMMAND_CHECK_ENABLED=true

# 危险命令前缀列表（匹配命令开头），每行一个，留空使用默认值
# DANGEROUS_COMMAND_PREFIXES=del \nerase \nrmdir \nrd \ncopy \nmove \nren \nrename \nmkdir \nmd

# 危险命令包含模式列表（匹配命令任意位置），每行一个，留空使用默认值
# DANGEROUS_COMMAND_CONTAINS= > \n >> \n set-content \n add-content \n out-file \n new-item \n remove-item \n rm
