OPENAI_API_KEY = ""
OPENAI_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
MODEL_NAME = "qwen3.5-plus-2026-02-15"
MAX_ITERATIONS = 20

SKILL_AGENT_UI_SHOW_TOOL_CALLS= 1
WORKER_DIR="PersonalData"
