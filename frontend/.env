# 浏览器 dev 模式：用 vite proxy 转发 /api 与 /ws，无需 VITE_BACKEND_URL
# Tauri 打包后：由 Rust 注入（invoke('get_backend_url')），覆盖此值
# Tauri dev + BACKEND_EXTERNAL：Rust 也会注入，但 fallback 用此值
VITE_BACKEND_URL=http://127.0.0.1:8765
VITE_BACKEND_TOKEN=

# ========== 窗口尺寸配置 ==========
# 注意：Tauri 外壳启动时会从项目根目录的 .env（而非本文件）优先加载窗口配置。
# 若需要单独为 Tauri dev 定制窗口大小，可取消下面注释并调整数值。
# WINDOW_WIDTH=1280
# WINDOW_HEIGHT=800
# WINDOW_MIN_WIDTH=800
# WINDOW_MIN_HEIGHT=600
