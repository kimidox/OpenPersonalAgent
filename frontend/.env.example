# 后端连接配置（开发期）
# 浏览器 dev 模式：用 vite proxy 转发 /api 与 /ws，无需 VITE_BACKEND_URL
# Tauri 打包后：由 Rust 注入（invoke('get_backend_url')），覆盖此值
VITE_BACKEND_URL=
VITE_BACKEND_TOKEN=

# ========== 窗口尺寸配置（可选） ==========
# Tauri 会从工作目录向上查找 .env 文件加载这些配置。
# 若未设置则使用默认值：1200x800 (最小 800x600)。
# 推荐在项目根目录 .env 中统一配置（与旧 Flet 入口共享）。
# WINDOW_WIDTH=1280
# WINDOW_HEIGHT=800
# WINDOW_MIN_WIDTH=800
# WINDOW_MIN_HEIGHT=600
