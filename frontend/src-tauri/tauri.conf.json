{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonalWindowGLM",
  "version": "1.0.0",
  "identifier": "com.kimido.personalwindowglm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PersonalWindowGLM",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "application.ico"
    ],
    "externalBin": [],
    "resources": {
      "../../dist-sidecar/backend_service": "backend_service/"
    }
  }
}
